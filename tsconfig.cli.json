{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "noEmit": false,
    "composite": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/cli/**/*.ts", "src/shared/pageJson.ts"]
}
